rules_version = '2';
// Workout app: each signed-in user can read/write ONLY their own document users/{uid}.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'updatedAt', 'schema', 'device'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.updatedAt is int;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
